# Local environment for the server-side tooling only (never imported by the browser app).
# Copy to .env and fill in; .env is gitignored.

# Archil API key (starts with key-, region-scoped). Not a disk/mount token (adt_...).
ARCHIL_API_KEY=
# Region the key was created in.
ARCHIL_REGION=aws-us-east-1
# Disk id (dsk-...) that holds exported playground projects.
ARCHIL_DISK_ID=
